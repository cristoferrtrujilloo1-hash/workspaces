olor: #f0fdf4;\n  color: #15803d;\n  border: 1px solid #bbf7d0;\n}\n.badge-credit {\n  background-color: #eff6ff;\n  color: #1d4ed8;\n  border: 1px solid #bfdbfe;\n}\n\n/* Estilos de Impresión */\n@media print {\n  /* Ocultar elementos de interfaz no deseados al imprimir */\n  header, footer, nav, .no-print, #toast-container, .fixed {\n    display: none !important;\n  }\n\n  body {\n    background-color: #ffffff !important;\n    color: #000000 !important;\n    padding: 0 !important;\n    margin: 0 !important;\n  }\n\n  /* Si se está imprimiendo un ticket individual */\n  body.printing-ticket #print-area {\n    display: block !important;\n    position: static !important;\n    width: 100% !important;\n    margin: 0 auto !important;\n    padding: 0 !important;\n  }\n\n  body.printing-ticket main {\n    display: none !important;\n  }\n\n  /* Formato ticket 80mm */\n  .ticket-style {\n    max-width: 80mm !important;\n    width: 100% !important;\n    margin: 0 auto !important;\n    padding: 8px !important;\n    font-family: 'Courier New', Courier, monospace !important;\n    font-size: 12px !important;\n    border: none !important;\n    box-shadow: none !important;\n  }\n\n  /* Formato reporte general A4/Carta */\n  body.printing-report main {\n    display: block !important;\n  }\n  \n  body.printing-report #tab-content-reportes {\n    display: block !important;\n  }\n\n  body.printing-report .tab-content:not(#tab-content-reportes) {\n    display: none !important;\n  }\n}\n","Target":"/* Estilos personalizados y utilidades de impresión para Sistema de Créditos */\n\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n:root {\n  --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;\n  --font-mono: 'JetBrains Mono', monospace;\n}\n\nbody {\n  font-family: var(--font-sans);\n  background-color: #f8fafc;\n  color: #1e293b;\n}\n\n/* Animaciones suaves */\n.transition-all-fast {\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* Scrollbar estilizada */\n::-webkit-scrollbar {\n  width: 7px;\n  height: 7px;\n}\n::-webkit-scrollbar-track {\n  background: #f1f5f9;\n}\n::-webkit-scrollbar-thumb {\n  background: #cbd5e1;\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #94a3b8;\n}\n\n/* Efectos de tarjeta */\n.card-hover {\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n.card-hover:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);\n}\n\n/* Badges y estados */\n.badge-debt {\n  background-color: #fef2f2;\n  color: #b91c1c;\n  border: 1px solid #fecaca;\n}\n.badge-clean {\n  background-color: #f0fdf4;\n  color: #15803d;\n  border: 1px solid #bbf7d0;\n}\n.badge-credit {\n  background-color: #eff6ff;\n  color: #1d4ed8;\n  border: 1px solid #bfdbfe;\n}\n\n/* Estilos de Ticket para Impresión */\n@media print {\n  body * {\n    visibility: hidden;\n  }\n  \n  #print-area, #print-area * {\n    visibility: visible;\n  }\n\n  #print-area {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 100%;\n    margin: 0;\n    padding: 15px;\n    background: white;\n    color: black;\n    font-size: 13px;\n  }\n\n  .no-print {\n    display: none !important;\n  }\n\n  .ticket-style {\n    max-width: 80mm !important;\n    margin: 0 auto !important;\n    padding: 10px !important;\n    font-family: 'Courier New', Courier, monospace !important;\n    font-size: 12px !important;\n    border: none !important;\n    box-shadow: none !important;\n  }\n\n  .report-style {\n    max-width: 100% !important;\n    margin: 0 !important;\n    padding: 20px !important;\n    font-family: var(--font-sans) !important;\n    box-shadow: none !important;\n    border: none !important;\n  }\n}"}}]}
