{"step_index":41,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T15:22:45Z","content":"Created At: 2026-10-29T09:22:45-06:00\nCompleted At: 2026-10-29T09:22:45-06:00\nShowing lines 140-220 of 1318\n140: // --- FUNCIONES DE PERSISTENCIA ---\n141: function loadData() {\n142:   try {\n143:     const savedConfig = localStorage.getItem(STORAGE_KEYS.CONFIG);\n144:     const savedClients = localStorage.getItem(STORAGE_KEYS.CLIENTS);\n145:     const savedTx = localStorage.getItem(STORAGE_KEYS.TRANSACTIONS);\n146: \n147:     appState.config = savedConfig ? JSON.parse(savedConfig) : { ...DEFAULT_CONFIG };\n148:     appState.clients = savedClients ? JSON.parse(savedClients) : [...INITIAL_CLIENTS];\n149:     appState.transactions = savedTx ? JSON.parse(savedTx) : [...INITIAL_TRANSACTIONS];\n150: \n151:     // Si era la primera vez, guardar los valores iniciales\n152:     if (!savedConfig) saveData();\n153:   } catch (error) {\n154:     console.error('Error cargando datos locales:', error);\n155:     appState.config = { ...DEFAULT_CONFIG };\n156:     appState.clients = [...INITIAL_CLIENTS];\n157:     appState.transactions = [...INITIAL_TRANSACTIONS];\n158:   }\n159: }\n160: \n161: function saveData() {\n162:   try {\n163:     localStorage.setItem(STORAGE_KEYS.CONFIG, JSON.stringify(appState.config));\n164:     localStorage.setItem(STORAGE_KEYS.CLIENTS, JSON.stringify(appState.clients));\n165:     localStorage.setItem(STORAGE_KEYS.TRANSACTIONS, JSON.stringify(appState.transactions));\n166:   } catch (error) {\n167:     console.error('Error guardando en almacenamiento local:', error);\n168:     showToast('Error al guardar datos en el navegador', 'error');\n169:   }\n170: }\n171: \n172: // --- CÁLCULOS FINANCIEROS POR CLIENTE ---\n173: function getClientBalance(clientId) {\n174:   const clientTx = appState.transactions.filter(t => t.clientId === clientId);\n175:   const totalCredit = clientTx\n176:     .filter(t => t.type === 'credit')\n177:     .reduce((sum, t) => sum + Number(t.amount || 0), 0);\n178:   const totalPaid = clientTx\n179:     .filter(t => t.type === 'payment')\n180:     .reduce((sum, t) => sum + Number(t.amount || 0), 0);\n181:   \n182:   const balance = totalCredit - totalPaid;\n183:   const lastCredit = clientTx\n184:     .filter(t => t.type === 'credit')\n185:     .sort((a, b) => new Date(b.date + ' ' + (b.time || '00:00')) - new Date(a.date + ' ' + (a.time || '00:00')))[0];\n186: \n187:   return {\n188:     totalCredit,\n189:     totalPaid,\n190:     balance: Math.round(balance * 100) / 100,\n191:     lastCreditDate: lastCredit ? lastCredit.date : null,\n192:     pendingTransactionsCount: clientTx.filter(t => t.type === 'credit').length\n193:   };\n194: }\n195: \n196: function formatCurrency(amount) {\n197:   const curr = appState.config.currency || '$';\n198:   return `${curr} ${Number(amount || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n199: }\n200: \n201: function formatDate(dateStr) {\n202:   if (!dateStr) return 'N/A';\n203:   const parts = dateStr.split('-');\n204:   if (parts.length === 3) {\n205:     return `${parts[2]}/${parts[1]}/${parts[0]}`;\n206:   }\n207:   return dateStr;\n208: }\n209: \n210: // --- NOTIFICACIONES / TOASTS ---\n211: function showToast(message, type = 'success') {\n212:   const container = document.getElementById('toast-container');\n213:   if (!container) return;\n214: \n215:   const toast = document.createElement('div');\n216:   const bgClass = type === 'error' ? 'bg-red-600' : type === 'warning' ? 'bg-amber-600' : 'bg-emerald-600';\n217:   const icon = type === 'error' ? '⚠️' : type === 'warning' ? '⚡' : '✅';\n218: \n219:   toast.className = `${bgClass} text-white px-4 py-3 rounded-xl shadow-lg flex items-center space-x-2 text-sm font-medium transition-all duration-300 transform translate-y-2 opacity-0`;\n220:   toast.innerHTML = `<span>${icon}</span> <span>${message}</span>`;"}
