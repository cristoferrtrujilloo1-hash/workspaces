n45:     phone: '5544332211',\n46:     creditLimit: 30.00,\n47:     notes: 'Pasa a almorzar de lunes a viernes',\n48:     createdAt: '2026-10-20T14:15:00.000Z'\n49:   }\n50: ];\n51: \n52: const INITIAL_TRANSACTIONS = [\n53:   // Carlos Mendoza\n54:   {\n55:     id: 'tx-1',\n56:     clientId: 'cli-1',\n57:     type: 'credit',\n58:     amount: 14.50,\n59:     date: '2026-10-25',\n60:     time: '13:30',"}
