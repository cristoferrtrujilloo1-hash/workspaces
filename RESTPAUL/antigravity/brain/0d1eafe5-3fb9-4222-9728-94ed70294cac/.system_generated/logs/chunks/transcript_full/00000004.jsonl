{"step_index":134,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T20:49:23Z","content":"Created At: 2026-10-29T14:49:23-06:00\nCompleted At: 2026-10-29T14:49:23-06:00\nShowing lines 230-280 of 1693\n230:     showToast('Error al guardar datos en el navegador', 'error');\n231:   }\n232: }\n233: \n234: // --- CÁLCULOS FINANCIEROS POR CLIENTE ---\n235: function getClientBalance(clientId) {\n236:   const clientTx = appState.transactions.filter(t => t.clientId === clientId);\n237:   const totalCredit = clientTx\n238:     .filter(t => t.type === 'credit')\n239:     .reduce((sum, t) => sum + Number(t.amount || 0), 0);\n240:   const totalPaid = clientTx\n241:     .filter(t => t.type === 'payment')\n242:     .reduce((sum, t) => sum + Number(t.amount || 0), 0);\n243:   \n244:   const balance = totalCredit - totalPaid;\n245:   const lastCredit = clientTx\n246:     .filter(t => t.type === 'credit')\n247:     .sort((a, b) => new Date(b.date + ' ' + (b.time || '00:00')) - new Date(a.date + ' ' + (a.time || '00:00')))[0];\n248: \n249:   return {\n250:     totalCredit,\n251:     totalPaid,\n252:     balance: Math.round(balance * 100) / 100,\n253:     lastCreditDate: lastCredit ? lastCredit.date : null,\n254:     pendingTransactionsCount: clientTx.filter(t => t.type === 'credit').length\n255:   };\n256: }\n257: \n258: function formatCurrency(amount) {\n259:   const curr = appState.config.currency || 'Q.';\n260:   return `${curr} ${Number(amount || 0).toLocaleString('es-GT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n261: }\n262: \n263: function formatDate(dateStr) {\n264:   if (!dateStr) return 'N/A';\n265:   const parts = dateStr.split('-');\n266:   if (parts.length === 3) {\n267:     return `${parts[2]}/${parts[1]}/${parts[0]}`;\n268:   }\n269:   return dateStr;\n270: }\n271: \n272: // --- NOTIFICACIONES / TOASTS PROFESIONALES ---\n273: function showToast(message, type = 'success') {\n274:   const container = document.getElementById('toast-container');\n275:   if (!container) return;\n276: \n277:   const toast = document.createElement('div');\n278:   const borderClass = type === 'error' ? 'border-red-500' : type === 'warning' ? 'border-amber-500' : 'border-emerald-500';\n279:   const icon = type === 'error' ? ICONS.alertTriangle : type === 'warning' ? ICONS.alertTriangle : ICONS.checkCircle;\n280:   const iconColor = type === 'error' ? 'text-red-500' : type === 'warning' ? 'text-amber-500' : 'text-emerald-500';"}
