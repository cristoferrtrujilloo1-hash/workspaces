      ` : ''}\n    </body>\n    </html>\n  `;\n\n  const blob = new Blob([xlsTemplate], { type: 'application/vnd.ms-excel;charset=utf-8' });\n  const url = URL.createObjectURL(blob);\n  const link = document.createElement('a');\n  link.setAttribute('href', url);\n  const dateStr = new Date().toISOString().slice(0, 10);\n  link.setAttribute('download', `reporte_cobranza_${dateStr}.xls`);\n  document.body.appendChild(link);\n  link.click();\n  document.body.removeChild(link);\n  URL.revokeObjectURL(url);\n  showToast('Reporte en Excel (.XLS) descargado con columnas alineadas');\n}\n\n// Alias para retrocompatibilidad\nfunction exportDebtorsToCSV() {\n  exportDebtorsToXLS();\n}","Target":"// --- EXPORTAR A EXCEL (CSV) ---\nfunction exportDebtorsToCSV() {\n  const debtors = appState.clients\n    .map(c => ({\n      client: c,\n      stats: getClientBalance(c.id)\n    }))\n    .filter(item => item.stats.balance > 0)\n    .sort((a, b) => b.stats.balance - a.stats.balance);\n\n  if (debtors.length === 0) {\n    showToast('No hay cuentas pendientes para exportar', 'warning');\n    return;\n  }\n\n  let csvContent = '\\uFEFF';\n  csvContent += 'No,Nombre,Referencia / Empresa,Telefono,Ultimo Consumo,Total Consumido,Total Abonado,Saldo Pendiente\\n';\n\n  debtors.forEach((item, index) => {\n    const { client, stats } = item;\n    const cleanName = `\"${(client.name || '').replace(/\"/g, '\"\"')}\"`;\n    const cleanAlias = `\"${(client.alias || '').replace(/\"/g, '\"\"')}\"`;\n    const cleanPhone = `\"${(client.phone || '').replace(/\"/g, '\"\"')}\"`;\n    const lastDate = stats.lastCreditDate ? formatDate(stats.lastCreditDate) : 'N/A';\n    \n    csvContent += `${index + 1},${cleanName},${cleanAlias},${cleanPhone},${lastDate},${stats.totalCredit.toFixed(2)},${stats.totalPaid.toFixed(2)},${stats.balance.toFixed(2)}\\n`;\n  });\n\n  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });\n  const url = URL.createObjectURL(blob);\n  const link = document.createElement('a');\n  link.setAttribute('href', url);\n  link.setAttribute('download', `reporte_cobranza_${new Date().toISOString().slice(0, 10)}.csv`);\n  document.body.appendChild(link);\n  link.click();\n  document.body.removeChild(link);\n  showToast('Reporte CSV generado para Microsoft Excel');\n}"}}]}
