5:   showToast('Reporte CSV generado para Microsoft Excel');\n1376: }\n1377: \n1378: // --- CONFIGURACIÓN DEL NEGOCIO ---\n1379: function loadConfigIntoForm() {\n1380:   document.getElementById('cfg-business-name').value = appState.config.businessName || '';"}
