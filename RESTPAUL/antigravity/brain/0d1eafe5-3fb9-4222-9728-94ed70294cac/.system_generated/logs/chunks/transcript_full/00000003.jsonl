{"step_index":109,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T16:56:45Z","content":"Created At: 2026-10-29T10:56:45-06:00\nCompleted At: 2026-10-29T10:56:45-06:00\nShowing lines 680-750 of 1546\n680:   const notes = document.getElementById('client-notes').value.trim();\n681:   const creditLimit = parseFloat(document.getElementById('client-limit').value) || 0;\n682: \n683:   if (!name) {\n684:     showToast('El nombre del cliente es obligatorio', 'warning');\n685:     return;\n686:   }\n687: \n688:   const isEdit = idInput && idInput.value;\n689: \n690:   if (isEdit) {\n691:     const client = appState.clients.find(c => c.id === idInput.value);\n692:     if (client) {\n693:       client.name = name;\n694:       client.alias = alias;\n695:       client.phone = phone;\n696:       client.notes = notes;\n697:       client.creditLimit = creditLimit;\n698:       showToast('Cliente actualizado con éxito');\n699:     }\n700:   } else {\n701:     const newClient = {\n702:       id: 'cli-' + Date.now(),\n703:       name,\n704:       alias,\n705:       phone,\n706:       creditLimit,\n707:       notes,\n708:       createdAt: new Date().toISOString()\n709:     };\n710:     appState.clients.push(newClient);\n711:     showToast('Nuevo comensal registrado');\n712:   }\n713: \n714:   saveData();\n715:   closeModal('modal-add-client');\n716:   renderClientsList();\n717:   populateClientSelects();\n718:   document.getElementById('client-form').reset();\n719:   if (idInput) idInput.value = '';\n720: }\n721: \n722: function editClient(clientId) {\n723:   const client = appState.clients.find(c => c.id === clientId);\n724:   if (!client) return;\n725: \n726:   document.getElementById('client-form-id').value = client.id;\n727:   document.getElementById('client-name').value = client.name || '';\n728:   document.getElementById('client-alias').value = client.alias || '';\n729:   document.getElementById('client-phone').value = client.phone || '';\n730:   document.getElementById('client-limit').value = client.creditLimit || '';\n731:   document.getElementById('client-notes').value = client.notes || '';\n732: \n733:   document.getElementById('modal-client-title').textContent = 'Editar Datos del Comensal';\n734:   document.getElementById('btn-delete-client').classList.remove('hidden');\n735: \n736:   openModal('modal-add-client');\n737: }\n738: \n739: function deleteCurrentClient() {\n740:   const id = document.getElementById('client-form-id').value;\n741:   if (!id) return;\n742: \n743:   const client = appState.clients.find(c => c.id === id);\n744:   if (!client) return;\n745: \n746:   const { balance } = getClientBalance(id);\n747:   let confirmMsg = `¿Deseas eliminar a \"${client.name}\"?`;\n748:   if (balance > 0) {\n749:     confirmMsg += `\\n⚠️ ATENCIÓN: Tiene un saldo pendiente de ${formatCurrency(balance)}. También se borrarán sus registros de consumos.`;\n750:   }"}
